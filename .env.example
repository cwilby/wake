# Existing MySQL instance (the Compose file does not start a database).
WAKE_MYSQL_HOST=
WAKE_MYSQL_USERNAME=
WAKE_MYSQL_PASSWORD=
WAKE_MYSQL_DATABASE=
WAKE_HTTP_PORT=3000

# Pushover app token and user key for scheduled shutdown warnings.
WAKE_PUSHOVER_APP_TOKEN=
WAKE_PUSHOVER_USER_KEY=

# Public URL your phone can open. May include the Wake port, e.g. http://wake.example:8091
WAKE_PUBLIC_URL=

# Optional: limit Pushover delivery to a named device.
WAKE_PUSHOVER_DEVICE=

# Required when using SSH shutdown strategies. Generate once and keep it stable:
# openssl rand -base64 32
WAKE_SSH_KEY_ENCRYPTION_KEY=
